{
  "name": "eslint-plugin-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["scope:plugin"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm eslint .",
        "cwd": "packages/eslint-plugin-cli"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm eslint . --fix",
        "cwd": "packages/eslint-plugin-cli"
      }
    }
  }
}
