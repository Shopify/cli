# Dependencies
node_modules/

# Build output (anchored so nested `dist/` directories under
# src/data/types/<pkg>/<version>/ — produced by `update-apis.mjs --types-only`
# from npm package layouts — are NOT ignored).
/dist/

# Environment variables
.env

# OS files
.DS_Store

# IDE
.vscode/

# Logs
*.log
npm-debug.log*

# TypeScript build info
*.tsbuildinfo

# The repository-wide ignore rules exclude nested dist directories and
# generated-looking index declarations. Here they are vendored reference data,
# not build output, so they must remain tracked.
!src/data/types/**/dist/
!src/data/types/**/dist/**
!src/data/types/**/index.d.ts

data/*.json

# Generated by package build and maintenance scripts.
src/data-embedded/
src/data/mcp-instructions/
