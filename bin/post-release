#! /usr/bin/env bash

tag=$1

# Check if current branch starts with "stable"
current_branch=$(git branch --show-current)
if [[ ! $current_branch =~ ^stable ]]; then
    echo "Error: Must be on a stable branch (current: $current_branch)"
    exit 1
fi

# Check if git working directory is clean
if [[ -n $(git status -s) ]]; then
    echo "Error: Git working directory is not clean"
    git status
    exit 1
fi

world_host="${WGH_HOST:-$(git config --get --default '' wgh.host)}"
if [[ -z "$world_host" ]]; then
    echo "Error: World host is not configured"
    echo 'Set WGH_HOST or run `git config wgh.host <host>`'
    exit 1
fi

# Check if github print-auth is working (needed for the homebrew and notification PRs)
if ! $(/opt/dev/bin/dev github print-auth --password > /dev/null 2>&1); then
    echo "Error: GitHub CLI authentication failed"
    echo "Try running \`dev github print-auth\` manually"
    exit 1
fi

# Check if Delta auth is working (needed for the docs PR, which goes to shop/world)
if ! dt auth status --host "$world_host" --repo shop/world > /dev/null 2>&1; then
    echo "Error: Delta authentication failed"
    echo "Try running \`dt auth login --host \"$world_host\" --repo shop/world\` manually"
    exit 1
fi

# Create a PR to update homebrew
node ./bin/create-homebrew-pr.js

# Create a PR to update the docs
node ./bin/create-doc-pr.js

# Create a PR to add the release notification
node ./bin/create-notification-pr.js

